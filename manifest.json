{
  "id": "terminal",
  "name": "设备终端",
  "description": "常驻 Shell/SSH、TCP/UDP/串口和 RDP/VNC 桌面，支持加密中继、虚拟输入、截图与录屏",
  "version": "1.5.0",
  "author": "aide",
  "main": "index.js",
  "enabled": true,
  "settingsSchema": {
    "type": "object",
    "title": "插件参数",
    "description": "桌面依赖由 Aide 所在 Linux 运行环境提供；插件独立安装。",
    "properties": {
      "desktopRuntimeRoot": {
        "type": "string",
        "title": "可选桌面原生运行库目录",
        "description": "为空时使用系统 Xvfb、FreeRDP2/3、TigerVNC、xdotool 和 FFmpeg；可填管理员准备的运行库根目录（含usr/bin）。"
      }
    },
    "additionalProperties": true
  },
  "daemon": true,
  "workbench": {
    "protocol": 1,
    "entry": "workbench.html",
    "title": "设备终端工作台",
    "tools": [
      "terminal_session_list",
      "terminal_session_create",
      "terminal_session_input",
      "terminal_session_poll",
      "terminal_session_resize",
      "terminal_session_close",
      "terminal_session_logging",
      "terminal_session_logs",
      "terminal_session_delete",
      "terminal_session_files",
      "terminal_session_comm",
      "terminal_session_visibility",
      "terminal_session_relay_script",
      "terminal_session_relay_status",
      "terminal_session_relay_connect",
      "terminal_session_desktop"
    ],
    "closeBehavior": "detach"
  }
}

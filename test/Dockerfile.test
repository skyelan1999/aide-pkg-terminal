# Linux QA image for the full Terminal plugin suite.
# Includes the host-like pieces macOS lacks: Python cryptography/serial,
# a local OpenSSH sshd, udevadm and a headless X server.
ARG AIDE_TEST_BASE=node:24-bookworm-slim
FROM ${AIDE_TEST_BASE}
USER root
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 755 /usr/sbin/policy-rc.d \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
       python3 python3-cryptography python3-serial \
       openssh-client openssh-server udev procps iproute2 socat ca-certificates \
       xauth xvfb x11-apps x11-utils xfonts-base \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
CMD ["npm", "test"]
